# ===== Clerk =====
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Ruta de inicio de sesión (debe coincidir con la configurada en Clerk Dashboard)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ===== Cloudflare (para el seed vía API HTTP) =====
CF_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_D1_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CF_D1_DATABASE_NAME=plataforma-cursos-db

# URL pública del bucket R2 (opcional; usada por /api/admin/upload)
PUBLIC_R2_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ===== Desarrollo local =====
# Si la API corre en otro puerto (wrangler pages dev), apúntala aquí.
# Debe incluir el sufijo /api:
# NEXT_PUBLIC_API_BASE=http://localhost:8788/api
